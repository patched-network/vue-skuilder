{
  "name": "@vue-skuilder/common",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.2.37",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./docker": {
      "types": "./dist/docker/index.d.ts",
      "import": "./dist/docker/index.mjs",
      "require": "./dist/docker/index.cjs"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --watch-path=src scripts/build.mjs",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "lint:check": "npx eslint . --max-warnings 0"
  },
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "moment": "^2.30.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "stableVersion": "0.2.37"
}
